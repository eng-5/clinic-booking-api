{
  "name": "clinic-booking-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "smoke": "node scripts/smoke.js",
    "migrate:dev": "node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js up --database-url-var DATABASE_URL",
    "migrate:test": "node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js up --database-url-var DATABASE_URL_TEST",
    "migrate:down:dev": "node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js down --database-url-var DATABASE_URL",
    "migrate:prod": "node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js up --database-url-var DATABASE_URL_PROD"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}